# --- Server ---
PORT=8000
HOST=127.0.0.1
# The public https URL ngrok serves (no trailing slash). Used for OAuth discovery metadata.
PUBLIC_URL=https://your-name.ngrok-free.app

# --- Execution policy ---
# read_only | standard | unrestricted
SHELL_MODE=standard
DEFAULT_TIMEOUT_SECONDS=30
MAX_TIMEOUT_SECONDS=300
MAX_OUTPUT_BYTES=65536
MAX_BACKGROUND_JOBS=5
RATE_LIMIT_PER_MINUTE=60
# Comma-separated roots the file tools (list_directory/read_file) may access. Default: your home folder.
ALLOWED_PATHS=
# Refuse to start if running as Administrator unless this is true (keep false).
ALLOW_ELEVATED=false

# --- Auth: oauth (default) or token (local testing only) ---
AUTH_MODE=oauth
# Your identity provider (Auth0, Okta, Entra ID, Keycloak, ...). Must support OAuth 2.1 + dynamic client registration for MCP clients.
OAUTH_ISSUER=https://YOUR_TENANT.us.auth0.com/
# The API identifier / audience the IdP puts in access tokens. Recommended: PUBLIC_URL + /mcp
OAUTH_AUDIENCE=https://your-name.ngrok-free.app/mcp
# Optional; defaults to <issuer>/.well-known/jwks.json
OAUTH_JWKS_URL=
# Optional scope that must be present in the token (e.g. shell:execute)
OAUTH_REQUIRED_SCOPE=
# STRONGLY recommended: comma-separated token "sub" values (or emails) allowed to use this server.
ALLOWED_SUBJECTS=
# Only for AUTH_MODE=token (local testing): long random string
DEV_BEARER_TOKEN=

# Browser Origins allowed to call /mcp (non-browser MCP clients send no Origin). Usually leave empty.
ALLOWED_ORIGINS=

# --- Shell binaries / logs ---
POWERSHELL_BIN=powershell.exe
CMD_BIN=cmd.exe
AUDIT_LOG=logs/audit.jsonl
